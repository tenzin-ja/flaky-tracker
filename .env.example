# Copy to .env and fill in. Never commit .env.

# Database (matches docker-compose.yml)
DATABASE_URL=postgresql+psycopg://flaky:flaky@localhost:5432/flaky_tracker
TEST_DATABASE_URL=postgresql+psycopg://flaky:flaky@localhost:5432/flaky_tracker_test

# GitHub App (Settings → Developer settings → GitHub Apps → your app)
GITHUB_APP_CLIENT_ID=
GITHUB_APP_PRIVATE_KEY_PATH=./github-app.private-key.pem
GITHUB_WEBHOOK_SECRET=

# LLM (optional — explanations are skipped when empty)
LLM_API_KEY=
LLM_MODEL=

# Flaky detection
FLAKY_WINDOW_DAYS=30
FLAKY_MIN_EVENTS=1

LOG_LEVEL=INFO
