# Copy to .env and fill in. Never commit .env.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Matches docker-compose.yml. Tests create their own test_ database automatically.
DATABASE_URL=postgres://flaky:flaky@localhost:5432/flaky_tracker
REDIS_URL=redis://localhost:6379/0

# GitHub App (Settings → Developer settings → GitHub Apps → your app)
GITHUB_APP_CLIENT_ID=
GITHUB_APP_PRIVATE_KEY_PATH=./github-app.private-key.pem
GITHUB_WEBHOOK_SECRET=

# LLM (optional — explanations are skipped when empty)
LLM_API_KEY=
LLM_MODEL=

# Flaky detection
FLAKY_WINDOW_DAYS=30
FLAKY_MIN_EVENTS=1

LOG_LEVEL=INFO
